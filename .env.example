# PostgreSQL connection strings used by Prisma.
#
# For a plain local Postgres, both can be identical:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fantasy7?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fantasy7?schema=public"
#
# For a pooled host (e.g. Supabase), DATABASE_URL should be the pooled
# "transaction mode" connection (used by the app at runtime) and DIRECT_URL
# the direct/session-mode connection (used only by `prisma migrate`):
# DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"
